<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTituloFormGuardia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Guardia"
        android:textColor="?attr/colorOnBackground"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Tipo"
        android:textColor="?attr/colorOnBackground"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinnerTipoFormGuardia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:minHeight="48dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxBackgroundColor="?attr/colorSurfaceContainer">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNombreGuardia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del establecimiento"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxBackgroundColor="?attr/colorSurfaceContainer">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUbicacionGuardia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ubicación (dirección y localidad)"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxBackgroundColor="?attr/colorSurfaceContainer">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTelefonoGuardia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Teléfono"
            android:inputType="phone" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxBackgroundColor="?attr/colorSurfaceContainer">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etHorarioGuardia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Horario"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxBackgroundColor="?attr/colorSurfaceContainer">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFechaGuardia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha (aaaa-mm-dd)"
            android:inputType="date" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarGuardia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Guardar"
            android:textColor="?attr/colorOnPrimaryContainer"
            app:backgroundTint="?attr/colorPrimaryContainer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarGuardia"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar" />
    </LinearLayout>

</LinearLayout>
